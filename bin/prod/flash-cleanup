#!/bin/bash
set -euo pipefail

info() {
    echo "[info] $1" >> /var/log/reflash.log
    echo "$1"
}

info "-----------------------"
info "Starting cleanup script"
info "-----------------------"

REVISION=${1:-}
OUTFILE="/dev/mmcblk2"

# Refuse to run without a revision, rather than doing four-fifths of a flash.
#
# An empty $1 passes `set -u` - it is set, just empty - and then every
# per-revision step below silently does nothing: the Klipper config is not
# installed, and the device tree symlink is not made, so the board boots the
# generic Recore-all tree. On an A5/A6 that means DDR3 at 1.36V, under the
# 1.425V datasheet minimum, on the installed system. The flash reports success
# (#138). Better to fail here, before anything has been changed.
if [ -z "$REVISION" ]; then
    info "FATAL: no hardware revision given - refusing to flash"
    info "  get-recore-revision returned nothing; the eMMC config partition is"
    info "  unreadable or was not mounted. Nothing has been changed."
    exit 1
fi

info "Using Recore hardware revision $REVISION"
info "Overwriting block device $OUTFILE"

# Keep the log. It lives in the initramfs and dies with the reboot that ends
# every flash - which is exactly when its contents become interesting. Working
# out why a board booted the wrong device tree meant reconstructing the whole
# sequence from the flashed rootfs, because the log was already gone (#138).
#
# On EXIT rather than at the end, so a flash that dies half-way leaves its log
# behind too; that is the case worth having. Best effort throughout: this must
# never turn a successful flash into a failed one, and it must not disturb the
# exit status.
persist_log() {
    local rc=$?
    mountpoint -q /mnt/emmc && umount /mnt/emmc 2>/dev/null || true
    if [ -b "${OUTFILE}p2" ]; then
        mkdir -p /mnt/logsave 2>/dev/null || true
        if mount "${OUTFILE}p2" /mnt/logsave 2>/dev/null; then
            mkdir -p /mnt/logsave/var/log.hdd 2>/dev/null || true
            cp /var/log/reflash.log /mnt/logsave/var/log.hdd/reflash.log 2>/dev/null || true
            sync
            umount /mnt/logsave 2>/dev/null || true
        fi
    fi
    return $rc
}
trap persist_log EXIT

sync

info "Expanding partition 2 to fill disk"
parted -s "${OUTFILE}" resizepart 2 100%

# Re-read partition table
partprobe ${OUTFILE}

# ...then wait for the partition nodes to come back.
#
# partprobe returns once the kernel has re-read the table, but the kernel first
# *removes* the partition devices and udev recreates them asynchronously
# afterwards. So there is a window where /dev/mmcblk2p1 does not exist. udev
# usually wins that race, which is why this went unnoticed - when it loses, the
# very next line dies under set -e:
#
#   e2fsck: No such file or directory while trying to open /dev/mmcblk2p1
#   [flash-cleanup a5]: exit status 8
#
# and because that is line 2's `set -euo pipefail`, everything after is skipped:
# the filesystem resize, the UUID randomisation that stops the eMMC colliding
# with the USB image it was flashed from, and the per-revision device tree
# symlink. The board is left bootable but subtly wrong, which is worse than a
# clean failure. Observed flashing an A5.
udevadm settle --timeout=30 || true
for _ in $(seq 1 100); do
    if [ -b "${OUTFILE}p1" ] && [ -b "${OUTFILE}p2" ]; then break; fi
    sleep 0.1
done
if [ ! -b "${OUTFILE}p1" ] || [ ! -b "${OUTFILE}p2" ]; then
    info "Partition nodes did not reappear after partprobe - aborting before we half-finish"
    exit 1
fi

# e2fsck's exit status is a bitmask, not a boolean. 0 means "nothing was wrong";
# 1 means "errors were found AND CORRECTED", which is a success. Under this
# script's set -e a bare call therefore aborts the moment it repairs anything -
# and everything after this point is skipped silently: the resize, the UUID
# randomisation that stops the eMMC colliding with the USB image it was flashed
# from, /etc/rebuild-settings, the pre-generated host keys, and the per-revision
# device tree symlink (#127).
#
# That last one is why this is not cosmetic. Without the symlink an A5 boots the
# generic Recore-all tree and runs its DDR3 at 1.36V, under the 1.425V datasheet
# minimum for the part it is fitted with - on the installed system, not just
# under Reflash. The board boots and looks fine, and the only trace is
# /var/log/reflash.log stopping mid-way with no error.
#
#   1 = errors corrected
#   2 = errors corrected, reboot advised (nothing is mounted here, so moot)
#   4 = errors LEFT UNCORRECTED - a real failure
#   8+ = operational/usage error
#
# Needing a repair at all is itself worth knowing: it means the image or the
# write was interrupted, so say so rather than passing over it in silence.
check_fs() {
    local dev=$1 rc=0
    e2fsck -y -f "$dev" || rc=$?
    case $rc in
        0) info "  $dev: clean" ;;
        1|2) info "  $dev: errors found and repaired (e2fsck $rc) - the write or the image was interrupted" ;;
        *) info "  $dev: FAILED, errors left uncorrected (e2fsck $rc)"; return 1 ;;
    esac
}

info "Checking filesystems"
check_fs "${OUTFILE}p1"
check_fs "${OUTFILE}p2"

info "Performing offline resize of filesystem"
resize2fs "${OUTFILE}"p2

# Create new uuids so they are different than the USB drive
info "Creating new UUIDs"
tune2fs -U random ${OUTFILE}p1
tune2fs -U random ${OUTFILE}p2

UUID1=$(blkid -s UUID -o value ${OUTFILE}p1)
UUID2=$(blkid -s UUID -o value ${OUTFILE}p2)

mkdir -p /mnt/emmc
# mount and exchange UUID
mount ${OUTFILE}p2 /mnt/emmc
info "Updating fstab with new UUIDs"
sed -i "s:UUID=.* \/ :UUID=${UUID2} / :" /mnt/emmc/etc/fstab
sed -i "s:UUID=.* \/boot :UUID=${UUID1} /boot :" /mnt/emmc/etc/fstab

touch /mnt/emmc/root/.no_rootfs_resize

# Copy config file, if one is not already present
if test -d /mnt/emmc/home/printer; then
  cd /mnt/emmc/home/printer/ || exit
  if test -f klipper/config/generic-recore-"$REVISION".cfg; then
    info "Installing Klipper config file"
    cp klipper/config/generic-recore-"$REVISION".cfg printer_data/config/printer.cfg
  fi
  # Enable mainsail on mainsail distros
  if test -f printer_data/config/mainsail.cfg; then
    info "Including Mainsail in config file, above the first section"
    # Older distros has the include fiel as a comment
    sed -i 's/\#\[include mainsail.cfg\]//' printer_data/config/printer.cfg
    sed -i 's:\(\[recore.*\]\):\[include mainsail.cfg\]\n\n\1:' printer_data/config/printer.cfg
  fi
  # Enable fluidd on fluidd distros
  if test -f printer_data/config/fluidd.cfg; then
    info "Including Fluidd in config file, above the first section"
    # Older distros has the include fiel as a comment
    sed -i 's/\#\[include mainsail.cfg\]//' printer_data/config/printer.cfg
    sed -i 's:\(\[recore.*\]\):\[include fluidd.cfg\]\n\n\1:' printer_data/config/printer.cfg
  fi
fi

if [ -f /mnt/emmc/etc/default/armbian-firstrun ]; then
    sed -i 's/OPENSSHD_REGENERATE_HOST_KEYS=true/OPENSSHD_REGENERATE_HOST_KEYS=false/' /mnt/emmc/etc/default/armbian-firstrun
fi

info "Pre-generating SSH host keys"
# Delete first, or this generates nothing. `ssh-keygen -A` creates host keys
# only "if they do not already exist", and the images do ship them - baked into
# a cached Armbian rootfs, so every board flashed from any image built on that
# cache got the same key pair. Observed on two boards flashed from
# rebuild-barebone-891e72c, both presenting
# SHA256:tADe3k31lQ/ApIZZe6lGD0A3bFrI/argPFJ5aeIlPQo, with a comment of
# root@0306b8450d0c - a build-container hostname - and an mtime two weeks older
# than the image itself.
#
# The line above makes this worse rather than harmless: it turns off Armbian's
# own first-boot regeneration, so nothing else would ever have replaced them.
rm -f /mnt/emmc/etc/ssh/ssh_host_*
ssh-keygen -A -f /mnt/emmc

cd /
umount ${OUTFILE}p2

mount ${OUTFILE}p1 /mnt/emmc
sed -i "/^rootdev=.*/d" /mnt/emmc/armbianEnv.txt
sed -i '/^$/d' /mnt/emmc/armbianEnv.txt
echo "rootdev=UUID=${UUID2}" >> /mnt/emmc/armbianEnv.txt

cd /mnt/emmc/dtb/allwinner/ || exit
# An else, because this silently doing nothing is the whole of #138. It is also
# load-bearing beyond the installed system: boot.cmd reads the model out of this
# symlink to decide whether to raise the DRAM rail, so a missing symlink costs
# an A5/A6 its 1.5V under Reflash on the NEXT flash as well.
if test -f sun50i-a64-recore-"$REVISION".dtb; then
  info "Symlinking device tree for $REVISION"
  ln -sf sun50i-a64-recore-"$REVISION".dtb sun50i-a64-recore.dtb
else
  info "FATAL: no device tree for revision '$REVISION' in $(pwd)"
  info "  available: $(ls sun50i-a64-recore-*.dtb 2>/dev/null | tr '\n' ' ')"
  info "  the board would boot the generic tree - failing instead"
  cd /
  umount ${OUTFILE}p1
  exit 1
fi
cd /
umount ${OUTFILE}p1

sync
info "Cleanup script done!"

