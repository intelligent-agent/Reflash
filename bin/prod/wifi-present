#!/bin/bash
#
# Report whether a WiFi adapter is fitted, plus whatever iwd can tell us about
# it, as JSON.
#
# Presence comes from sysfs, not from iwd. The netdev is the physical fact: it
# exists from the moment the dongle is plugged in until it is pulled out. iwd's
# view of it is not - `iwctl device list` prints nothing while the device is
# being re-created, which is exactly what a mode change does, and wifi-scan
# changes mode twice (ap -> station to scan, back to ap afterwards). The UI
# polls this every 2s, so it reliably landed in that window and reported the
# dongle as missing mid-scan, collapsing the whole WiFi dialog.
#
# Everything from iwctl is therefore best effort: if it is unavailable we still
# say the adapter is there, just with fewer details.

# Defaults match the on-board layout; tests override via env to run hermetically.
INTERFACE="${WIFI_INTERFACE:-wlan0}"
SYS_NET="${SYS_NET:-/sys/class/net}"

if [ ! -d "$SYS_NET/$INTERFACE" ]; then
    # Exit 0: no dongle is a fact to report, not a failure of this script. It
    # used to exit 1, which made the server log an error on every 2s poll.
    echo '{"present": false}'
    exit 0
fi

# Strip terminal formatting, then find the row carrying a MAC address (5 colons).
RAW_LINE=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -E "([0-9a-fA-F]{2}:){5}" | head -n 1)

# iwd columns are: Name(1) Address(2) Powered(3) Adapter(4) Mode(5)
NAME=$(echo "$RAW_LINE" | awk '{print $1}')
ADDR=$(echo "$RAW_LINE" | awk '{print $2}')
POWR=$(echo "$RAW_LINE" | awk '{print $3}')
ADPT=$(echo "$RAW_LINE" | awk '{print $4}')
MODE=$(echo "$RAW_LINE" | awk '{print $5}')

# The interface name is known from sysfs even when iwd is mid-transition, and
# the UI shows it - so do not let it go blank just because iwctl was quiet.
[ -n "$NAME" ] || NAME="$INTERFACE"

printf '{"present": true, "name": "%s", "mac": "%s", "powered": "%s", "adapter": "%s", "mode": "%s"}\n' \
    "$NAME" "$ADDR" "$POWR" "$ADPT" "$MODE"

exit 0
