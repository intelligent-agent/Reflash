#!/bin/bash

ROTATION=$1
PLACE=$2

# Valid rotation options are normal,inverted,left,right
ROTATIONS=(0 90 180 270)

# Valid places to update
PLACES=(FBCON XORG CMDLINE WESTON PLYMOUTH)

EMMC=/dev/mmcblk2

info() {
    echo "[info] $1" >> /var/log/reflash.log
    echo "$1"
}

usage(){
    echo "Usage: $0 <rotation> <place>"
    echo "Valid  rotations: " "${ROTATIONS[@]}"
    echo "Valid  places: " "${PLACES[@]}"
}

update_xorg(){
    mkdir -p /mnt/emmc
    umount -q /mnt/emmc/
    mount "${EMMC}p2" /mnt/emmc

    XORG_DIR="/mnt/emmc/usr/share/X11/xorg.conf.d"
    if [ ! -d ${XORG_DIR} ]; then
        echo "Misssig directory: ${XORG_DIR}"
    else
        # Two Monitor sections on purpose. The connector name depends on which
        # driver owns the display in the image being flashed: sun4i-drm calls it
        # HDMI-1, while simpledrm - which reports DRM_MODE_CONNECTOR_Unknown -
        # is None-1 to Xorg. Reflash cannot know which one it just wrote, and a
        # Monitor section whose Identifier matches no output is simply unused,
        # so writing both covers old and new images alike.
        cat <<EOF > "${XORG_DIR}/90-monitor.conf"
Section "Monitor"
    Identifier "HDMI-1"
    Option "Rotate" "$ROT_XORG"
EndSection
Section "Monitor"
    Identifier "None-1"
    Option "Rotate" "$ROT_XORG"
EndSection
Section "InputClass"
    Identifier "Coordinate Transformation Matrix"
    MatchIsTouchscreen "on"
    MatchDevicePath "/dev/input/event*"
    MatchDriver "libinput"
    Option "CalibrationMatrix" "$ROT_MATRIX"
EndSection
EOF
    fi
    umount /mnt/emmc
}

update_weston(){
    mkdir -p /mnt/emmc
    umount -q /mnt/emmc/ || true
    mount "${EMMC}p2" /mnt/emmc

    RELEASE=$(cut -d '.' -f 1 /mnt/emmc/etc/debian_version)
    CONFIG_FILE="/mnt/emmc/etc/xdg/weston/weston.ini"

    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Misssig file: ${CONFIG_FILE}"
    else
        case "$RELEASE" in
            11 | 12 | 13)
                sed -i "s/transform.*/transform=${ROT_WESTON_11}/" "${CONFIG_FILE}"
                ;;
            10)
                sed -i "s/transform.*/transform=${ROT_WESTON_10}/" "${CONFIG_FILE}"
                ;;
            *)
                echo "Unknown debian release: '${RELEASE}'"
                ;;
        esac
    fi
    umount /mnt/emmc
}

update_cmdline(){
    mkdir -p /mnt/emmc
    umount -q /mnt/emmc/
    mount "${EMMC}p1" /mnt/emmc

    # Test for the thing the sed below actually rewrites, not merely for
    # "fbcon=". There is more than one fbcon parameter: barebone images ship
    # fbcon=nodefer so the console takes over the panel at boot (Rebuild #90),
    # and matching that made this take the first branch, find no
    # "fbcon=rotate:" to substitute, and silently leave the image with no
    # rotation at all.
    if grep -q 'fbcon=rotate:[0-3]' /mnt/emmc/armbianEnv.txt; then
        sed -i "s/\(fbcon=rotate:\)[0-3]/\1${ROT_FBCON}/" /mnt/emmc/armbianEnv.txt
    else
        sed -i "/extraargs=/ s/$/ fbcon=rotate:${ROT_FBCON}/" /mnt/emmc/armbianEnv.txt
    fi
    cat /mnt/emmc/armbianEnv.txt
    umount /mnt/emmc
}

update_fbcon() {
    echo $ROT_FBCON > /sys/devices/virtual/graphics/fbcon/rotate
}

# Plymouth's DRM renderer ignores fbcon=rotate: entirely (that only
# affects the legacy fbcon text console - and note fbcon=rotate: is itself
# a no-op unless CONFIG_FRAMEBUFFER_CONSOLE_ROTATION is set in the
# kernel). Plymouth reads the kernel's DRM panel orientation instead, set
# via video=<connector>:panel_orientation=<value> on the command line.
#
# Deliberately NO mode is pinned here. An earlier version detected the
# panel's preferred mode and wrote video=HDMI-A-1:<w>x<h>, which did fix
# an invisible boot splash: sun8i-dw-hdmi reports HPD low for ~570ms while
# its PHY starts, DRM builds the fbdev console inside that window without
# an EDID, drm_add_modes_noedid() invents 1024x768, and drm_fb_helper -
# which allocates once and cannot grow - makes that guess permanent. The
# panel cannot lock, drops sync and blanks its own backlight.
#
# But a pinned mode also overrides the EDID of whatever panel is attached
# later, so swapping the screen would misconfigure the new one. Rebuild
# now solves it upstream of all this instead: sun4i-drm is not built at
# all (CONFIG_DRM_SUN4I=n, CONFIG_DRM_SIMPLEDRM=y) and the panel is driven
# from the framebuffer u-boot already programmed from the real EDID and
# handed over via /chosen/framebuffer-hdmi. Every panel therefore gets its
# own mode, chosen by u-boot rather than guessed by the kernel.
#
# Both connector names are written for the same reason as update_xorg:
# sun4i-drm images call it HDMI-A-1, simpledrm images Unknown-1, and the
# kernel silently ignores a video= argument for a connector that does not
# exist.
update_plymouth(){
    mkdir -p /mnt/emmc
    umount -q /mnt/emmc/ || true
    mount "${EMMC}p1" /mnt/emmc

    CONFIG_FILE="/mnt/emmc/armbianEnv.txt"
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Misssig file: ${CONFIG_FILE}"
    else
        # Drop any previous video= argument for either connector before
        # re-adding them: a mode pinned by an older Reflash would otherwise
        # survive a re-flash and keep overriding the panel's EDID, and a
        # stale orientation would fight the new one.
        sed -i -E "s/ *video=(HDMI-A-1|Unknown-1):[^ ]*//g" "$CONFIG_FILE"
        sed -i "/extraargs=/ s|$| video=HDMI-A-1:panel_orientation=${ROT_PLYMOUTH} video=Unknown-1:panel_orientation=${ROT_PLYMOUTH}|" "$CONFIG_FILE"
        cat "$CONFIG_FILE"
    fi
    umount /mnt/emmc
}

if [ "$ROTATION" == "" ]; then
    usage 
    exit 1
fi

if [ "$PLACE" == "" ]; then
    usage
    exit 1
fi

case "${ROTATION}" in 
    0)
        ROT_XORG="normal"
        ROT_FBCON="0"
        # Confirmed empirically on real hardware.
        ROT_PLYMOUTH="normal"
        ROT_WESTON_10="0"
        ROT_WESTON_11="normal"
        ROT_MATRIX="1 0 0 0 1 0 0 0 1"
        ;;
    90)
        ROT_XORG="right"
        ROT_FBCON="1"
        # Not empirically confirmed - inferred by elimination
        # from the four DRM panel-orientation values, given 0 and
        # 270 are confirmed. Verify on hardware before trusting.
        ROT_PLYMOUTH="right_side_up"
        ROT_WESTON_10="270"
        ROT_WESTON_11="rotate-270"
        ROT_MATRIX="0 1 0 -1 0 1 0 0 1"
        ;;
    180)
        ROT_XORG="inverted"
        ROT_FBCON="2"
        # Not empirically confirmed - inferred by elimination, see
        # the note on the 90 case above.
        ROT_PLYMOUTH="upside_down"
        ROT_WESTON_10="180"
        ROT_WESTON_11="rotate-180"
        ROT_MATRIX="-1 0 1 0 -1 1 0 0 1"
        ;;
    270)
        ROT_XORG="left"
        ROT_FBCON="3"
        # Confirmed empirically on real hardware.
        ROT_PLYMOUTH="left_side_up"
        ROT_WESTON_10="90"
        ROT_WESTON_11="rotate-90"
        ROT_MATRIX="0 -1 1 1 0 0 0 0 1"
        ;;
    *)
        echo "$ROTATION not in " "${ROTATIONS[@]}"
        exit 1
        ;;
esac

info "Setting rotation to ${ROTATION} for place ${PLACE}"

case "${PLACE}" in 
    FBCON)
        update_fbcon
        ;;
    XORG)
        update_xorg
        ;;
    CMDLINE)
        update_cmdline
        ;;
    WESTON)
        update_weston
        ;;
    PLYMOUTH)
        update_plymouth
        ;;
    *)
        echo "$PLACE not in " "${PLACES[@]}"
        exit 1
        ;;
esac
