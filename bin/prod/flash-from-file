#!/bin/bash
set -euo pipefail

info() {
    echo "[info] $1" >> /var/log/reflash.log
    echo "$1"
}

info "----------------------------"
info "Starting recore flash script"
info "----------------------------"

INFILE=$1
OUTFILE="/dev/mmcblk2"

# One reader for the config partition, not three. This block was a third copy
# of get-recore-revision, so it mounted the partition itself - and every extra
# mount is a chance to collide with another reader on the transient systemd
# unit, which is what stopped a flash finishing (#138). Calling the script also
# means this gets the cache and the lock.
REVISION=$(get-recore-revision)

SIZE=$(xz -lv "$INFILE" | grep Uncompressed | sed 's/[,(]//g' | awk '{ printf "%s\n", $5 }')

info "Found Recore hardware revision $REVISION"
info "Flashing file name $INFILE"
info "Overwriting block device $OUTFILE"
info "Uncompressed file size is $SIZE bytes"

info "Umounting /dev/mmcblk*"
mount | grep '/dev/mmcblk' | cut -f 1 -d' ' | xargs -t -r -n 1 umount || true
info "Starting flashing..."
(xz -T 0 -d -c "$INFILE" | pv -f -n -b > "$OUTFILE") 2> /tmp/recore-flash-progress
info "Flashing done"
sync

# The same preparation as every other way of writing the eMMC. This used to be
# an older copy of flash-cleanup, inline, and it had drifted: no wait for the
# partition nodes (#145), a bare e2fsck that aborted on a repaired filesystem
# (#127), no partition growth, no new SSH host keys, and a missing device tree
# passed in silence - the generic tree, and an A5/A6's DRAM under voltage
# (#138). One path now, and it is the image's own installer where there is one
# (#179).
info "Preparing the installed image"
target-install prepare "$REVISION"

info "Recore flash script done!"
