#!/bin/bash

# Defaults match the on-board layout; tests override via env to run hermetically.
INTERFACE="${WIFI_INTERFACE:-wlan0}"
SYS_NET="${SYS_NET:-/sys/class/net}"
IWD_DIR="${IWD_DIR:-/var/lib/iwd}"
LOG_FILE="${LOG_FILE:-/var/log/reflash.log}"
AP_PROFILE="Recore"

SSID="$1"
PASS="$2"

info() {
    echo "[info] $1" >> "$LOG_FILE"
    echo "$1"
}

# A failed connection here (bad password, AP out of range, DHCP timeout)
# would otherwise leave the board in station mode with no working
# connection and no hotspot - unreachable until physical intervention (#90).
restore_hotspot() {
    info "Connection failed - restoring hotspot ($AP_PROFILE) so the board stays reachable."
    iwctl ap "$INTERFACE" stop 2>/dev/null
    iwctl device "$INTERFACE" set-property Mode ap
    iwctl ap "$INTERFACE" start-profile "$AP_PROFILE" 2>/dev/null
}

if [ -z "$SSID" ] || [ -z "$PASS" ]; then
    echo "Usage: $0 <SSID> <Password>"
    exit 1
fi

# No WiFi adapter present (e.g. no USB dongle): a connection is impossible, so
# fail with a non-zero status the server can surface to the user.
if [ ! -d "$SYS_NET/$INTERFACE" ]; then
    info "No WiFi adapter ($INTERFACE) present. Cannot connect to $SSID."
    exit 1
fi

info "Attempting to connect to SSID: $SSID"

# 1. Ensure we are in Station mode
CURRENT_MODE=$(iwctl device "$INTERFACE" show | grep "Mode" | awk '{print $NF}' | sed $'s/\x1b\[[0-9;]*m//g')

if [ "$CURRENT_MODE" == "ap" ]; then
    info "Switching from AP to Station mode..."
    iwctl ap "$INTERFACE" stop 2>/dev/null
    iwctl device "$INTERFACE" set-property Mode station
    sleep 2
fi

# 2. Create the iwd profile
info "Provisioning iwd profile for $SSID..."
mkdir -p "$IWD_DIR"
cat <<IWD_EOF > "$IWD_DIR/$SSID.psk"
[Settings]
AutoConnect=true

[Security]
Passphrase=$PASS
IWD_EOF

# Is this network in iwd's list yet? That list is what a connect can act on;
# anything else is a guess about timing.
#
# Exact whole-name match: the marker column, and the security/signal columns, are
# stripped first. A substring match would accept "Kraakeslottet" while only
# "Kraakeslottet_5GHz" was in range, and connect to the wrong network - or to no
# network at all.
scan_lists_ssid() {
    iwctl station "$INTERFACE" get-networks 2>/dev/null \
        | sed $'s/\x1b\[[0-9;]*m//g' \
        | sed 's/^[[:space:]]*>\{0,1\}[[:space:]]*//' \
        | sed 's/[[:space:]][[:space:]][[:space:]]*\(psk\|open\|8021x\).*$//' \
        | sed 's/[[:space:]]*$//' \
        | grep -qxF "$1"
}

# 3. Scan, wait for iwd to list the network - then connect either way.
#
# The old code was `scan; sleep 3` plus three connect attempts two seconds
# apart: a fixed budget of about seven seconds, whatever the scan actually cost.
# Waiting on the condition is better practice and drops an unconditional 3s
# sleep from every connect, including the common 2.4GHz one.
#
# What this is NOT is a fix for the 5GHz failure in #140. That looked like a
# slow-scan race - 5GHz failing while 2.4GHz worked first try - and it turned out
# to be a dead radio in one dongle, which received on 5GHz and never got a reply
# to anything it transmitted. The scan had almost certainly completed every time.
# No case has been observed where waiting longer turned a failure into a success.
#
# What it does buy is the distinction between "never discovered" and "discovered
# and refused". Before, both printed "Network not ready yet", and that conflation
# is what kept the investigation on the software for a day.
#
# So a missing name is a diagnostic, never a veto. This parses iwctl's
# human-readable table; if that layout changes the match will fail for a network
# that is really there, which would look exactly like the bug above. Attempting
# the connect regardless means a parsing slip costs a log line instead of an
# unreachable board - the old code would have tried, and so does this.
info "Scanning to discover $SSID..."
iwctl station "$INTERFACE" scan 2>/dev/null

# Short by default: this is a head start for the scan, not a budget the connect
# depends on, so overrunning it must not delay the failure much beyond what the
# fixed sleep used to cost.
SCAN_TIMEOUT="${WIFI_SCAN_TIMEOUT:-10}"
FOUND=""
for _ in $(seq 1 "$SCAN_TIMEOUT"); do
    if scan_lists_ssid "$SSID"; then FOUND=yes; break; fi
    sleep 1
done

if [ -n "$FOUND" ]; then
    info "Found $SSID in scan results."
else
    info "$SSID did not appear in a scan within ${SCAN_TIMEOUT}s - trying anyway. If the connect also fails, check the name, the signal, and whether this adapter can use that band."
fi

# 4. Trigger the connection
info "Requesting iwd to connect..."
# Still retried, but now only for a genuinely transient refusal - the slow-scan
# case it used to paper over is handled above.
for i in {1..3}; do
    if iwctl station "$INTERFACE" connect "$SSID"; then
        info "Connection command accepted."
        break
    fi
    info "Attempt $i: Network not ready yet, retrying..."
    sleep 2
    if [ $i -eq 3 ]; then
        info "Connection command failed after 3 attempts."
        restore_hotspot
        exit 1
    fi
done

# Reply on the interface the request arrived on.
#
# With Ethernet also up on the same subnet, the main table sends everything for
# that subnet out eth0 (metric 100) - including replies to connections that
# arrived on wlan0. Those replies leave the wire carrying the WiFi interface's
# source IP, which teaches the AP's bridge that this address lives on the wired
# side, and it stops forwarding frames for it over the air.
#
# The result is a connection that half-works and is very hard to read: the SYN
# gets in (it arrives before the mislearning), the board answers, and then the
# client's ACK never reaches it. The socket sits in SYN-RECV retransmitting
# SYN-ACK while the client believes it is connected and waits for a response
# that cannot come. Captured on an A6 (Reflash #126):
#
#   client -> 90:de:80:97:db:67  [S]     SYN, to the wlan0 MAC
#   board  -> client             [SA]    from 02:ba:33:9b:1e:76 - the eth0 MAC
#   client -> 90:de:80:97:db:67  [A]     ACK - never arrives
#   board  -> client             [SA]    retransmits, three more times
#
# Measured: HTTP to the WiFi address went from timing out at 20s to answering in
# 0.017s. It also removes a large latency penalty that was there even when it
# did work - 685ms for the same request.
#
# Not rp_filter (0 on every interface here) and not an MTU black hole (1472-byte
# DF pings pass both ways). Nothing needed on the Ethernet side: its replies
# already leave the interface they arrived on.
install_source_route() {
    local addr=$1 table=100
    [ -n "$addr" ] || return 0
    local net gw
    net=$(ip -4 route show dev "$INTERFACE" scope link | awk '/\/[0-9]+/ {print $1; exit}')
    gw=$(ip -4 route show default dev "$INTERFACE" | awk '/via/ {print $3; exit}')

    ip rule del from "$addr" lookup "$table" 2>/dev/null || true
    ip route flush table "$table" 2>/dev/null || true

    [ -n "$net" ] && ip route add "$net" dev "$INTERFACE" src "$addr" table "$table" 2>/dev/null
    [ -n "$gw" ]  && ip route add default via "$gw" dev "$INTERFACE" table "$table" 2>/dev/null
    ip rule add from "$addr" lookup "$table" 2>/dev/null

    if ip route get 1.1.1.1 from "$addr" 2>/dev/null | grep -q "dev $INTERFACE"; then
        info "Source routing: traffic from $addr now leaves $INTERFACE"
    else
        info "WARNING: could not install source routing for $addr - the WiFi address may be unreachable while Ethernet is up"
    fi
}

# 5. Wait and verify IP address
info "Waiting for DHCP..."
MAX_RETRIES=30
COUNT=0
while [ $COUNT -lt $MAX_RETRIES ]; do
    IP=$(ip addr show "$INTERFACE" | grep "inet " | awk '{print $2}')
    if [ -n "$IP" ]; then
        info "Success! Connected with IP: $IP"
        install_source_route "${IP%%/*}"
        exit 0
    fi
    sleep 1
    ((COUNT++))
done

info "Timed out waiting for IP address."

# Name which half failed. "No IP" covers three problems that need three
# different actions - retype the passphrase, move the board, look at the router
# - and reporting all of them as a DHCP timeout sent people to the wrong one.
# iwctl's exit status is not usable here: it prints failures and still exits 0,
# and association completes after the connect call has already returned.
STATE=$(iwctl station "$INTERFACE" show 2>/dev/null \
        | sed $'s/\x1b\[[0-9;]*m//g' | awk '/^ *State/ {print $2}')
case "$STATE" in
    connected)
        info "Associated with $SSID, but no IPv4 address arrived. This is a DHCP problem, not a password one." ;;
    connecting|*onnecting*)
        info "Still trying to associate with $SSID. Check the passphrase and the signal." ;;
    *)
        info "Never associated with $SSID (state: ${STATE:-unknown}). Check the passphrase." ;;
esac

restore_hotspot
exit 1

