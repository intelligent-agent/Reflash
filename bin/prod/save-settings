#!/bin/bash

CONTENT=$1

EMMC=/dev/mmcblk2
SETTINGS_FILE="/mnt/emmc/etc/rebuild-settings"

info() {
    echo "[info] $1" >> /var/log/reflash.log
    echo "$1"
}

usage(){
    echo "Usage: $0 <content>"
}

update_settings(){
    mkdir -p /mnt/emmc
    umount -q /mnt/emmc/
    mount "${EMMC}p2" /mnt/emmc

    # printf, not echo -e: the content arrives with real newlines, and -e
    # also turned any backslash in a passphrase into an escape (#157).
    printf '%s\n' "$CONTENT" > "$SETTINGS_FILE"
    chmod 600 "$SETTINGS_FILE"
    umount /mnt/emmc
}

info "Updating settings"

update_settings
